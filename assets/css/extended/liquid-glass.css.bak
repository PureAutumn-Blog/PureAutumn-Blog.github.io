
/* PureAutumn Liquid Glass 3.0 — Light Edition */

:root,
html[data-theme="light"] {
    color-scheme: light;

    --theme: #f3f7fc;
    --entry: rgba(255, 255, 255, 0.52);
    --primary: #172b46;
    --secondary: #63758e;
    --tertiary: rgba(100, 151, 210, 0.12);
    --content: #30445e;
    --code-block-bg: #edf3fa;
    --code-bg: rgba(255, 255, 255, 0.65);
    --border: rgba(255, 255, 255, 0.75);
}

html {
    min-height: 100%;
    background: #edf4fc;
}

body {
    min-height: 100vh;
    color: #172b46 !important;
    background:
        radial-gradient(ellipse at 10% 5%,
            rgba(135, 190, 255, 0.55), transparent 38%),
        radial-gradient(ellipse at 90% 18%,
            rgba(195, 180, 255, 0.42), transparent 36%),
        radial-gradient(ellipse at 55% 85%,
            rgba(148, 224, 239, 0.35), transparent 42%),
        linear-gradient(145deg, #f7faff, #e8f1fc 55%, #f5f1ff)
        fixed !important;
}

/* 页面容器透明，保留背景层次 */
#top,
.header,
.main,
.footer {
    background: transparent !important;
}

/* 顶部导航：白色半透明玻璃 */
.header {
    padding-top: 12px;
}

.header .nav {
    position: relative;
    box-sizing: border-box;
    min-height: 64px;
    padding: 0 20px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 23px;
    background:
        linear-gradient(120deg,
            rgba(255,255,255,0.92),
            rgba(255,255,255,0.48) 55%,
            rgba(221,235,255,0.62)),
        rgba(255,255,255,0.5) !important;
    -webkit-backdrop-filter: blur(28px) saturate(165%);
    backdrop-filter: blur(28px) saturate(165%);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.95),
        inset 0 -1px 0 rgba(177,205,239,0.25),
        0 12px 35px rgba(79,112,158,0.12);
}

.logo a,
#menu a {
    color: #263e5c;
    transition: color 180ms ease;
}

.logo a:hover,
#menu a:hover {
    color: #387bd4;
}

/* 首页介绍卡片 */
.first-entry {
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 28px;
    background:
        linear-gradient(135deg,
            rgba(255,255,255,0.88),
            rgba(255,255,255,0.42) 55%,
            rgba(222,235,255,0.58)) !important;
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    backdrop-filter: blur(28px) saturate(160%);
    box-shadow:
        inset 0 1px 0 #fff,
        0 18px 50px rgba(85,119,167,0.12);
}

/* 文章列表：轻盈透明 */
.post-entry {
    position: relative;
    overflow: hidden;
    margin-bottom: 18px;
    border: 1px solid rgba(255,255,255,0.88);
    border-radius: 22px;
    background:
        linear-gradient(130deg,
            rgba(255,255,255,0.78),
            rgba(255,255,255,0.43) 65%,
            rgba(230,240,255,0.56)) !important;
    -webkit-backdrop-filter: blur(22px) saturate(155%);
    backdrop-filter: blur(22px) saturate(155%);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.95),
        0 9px 28px rgba(83,115,160,0.09);
    transition: transform 200ms ease, box-shadow 200ms ease;
}

.post-entry:hover {
    transform: translateY(-2px);
    box-shadow:
        inset 0 1px 0 #fff,
        0 15px 38px rgba(83,115,160,0.16);
}

.entry-content,
.entry-footer,
.post-meta {
    color: #687b95;
}

/* 文章正文 */
.post-single {
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 26px;
    background: rgba(255,255,255,0.58);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.95),
        0 12px 35px rgba(83,115,160,0.08);
}

.post-content {
    color: #30445e;
    line-height: 1.85;
}

.post-content a {
    color: #2878d4;
    text-decoration-color: rgba(40,120,212,0.35);
    text-underline-offset: 4px;
}

.post-content a:hover {
    color: #6556c9;
}

/* 文章标题居中 */
.home-info .entry-header,
.home-info .entry-content,
.post-entry .entry-header,
.post-header,
.post-header .post-title,
.post-header .post-meta,
.page-header {
    text-align: center;
}

.home-info .entry-content {
    max-width: 680px;
    margin-inline: auto;
}


/* 代码块：统一外框，避免多层边框叠加 */
pre,
div.highlight {
    box-sizing: border-box;
    max-width: 100%;
    border: 1px solid #dce7f5;
    border-radius: 15px;
    background: #edf3fa !important;
    color: #263e5c;
}

/* PaperMod 内部代码容器不再重复绘制外框 */
div.highlight .chroma,
div.highlight pre,
pre.chroma {
    border: 0 !important;
    border-radius: inherit;
    background: transparent !important;
    box-shadow: none !important;
}

pre {
    padding: 17px;
    overflow-x: auto;
}

.post-content :not(pre) > code {
    padding: 0.15em 0.4em;
    color: #285f9f;
    border: 1px solid #dce8f8;
    border-radius: 5px;
    background: rgba(224, 237, 253, 0.75);
}

/* 目录、面包屑、分页 */
.toc,
.breadcrumbs,
.paginav,
.pagination a {
    border: 1px solid rgba(255,255,255,0.85);
    border-radius: 16px;
    background: rgba(255,255,255,0.55);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
}

.toc {
    padding: 15px 19px;
}

.terms-tags a,
.post-tags a {
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 999px;
    background: rgba(255,255,255,0.65);
    color: #38618f;
}

.terms-tags a:hover,
.post-tags a:hover {
    background: rgba(210,229,255,0.85);
}

/* 引用与图片 */
.post-content blockquote {
    border-inline-start: 3px solid #82b8f4;
    border-radius: 0 12px 12px 0;
    background: rgba(221,236,255,0.65);
    padding: 12px 18px;
}

.post-content img {
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(83,115,160,0.12);
}

/* 页脚与回到顶部 */
.footer {
    color: #71839a;
}

#top-link {
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 14px;
    background: rgba(255,255,255,0.72);
    color: #30445e;
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
}

/* 手机端适配 */
@media (max-width: 768px) {
    .header {
        padding-top: 6px;
    }

    .header .nav {
        min-height: 58px;
        padding: 0 12px;
        border-radius: 18px;
    }

    .first-entry {
        border-radius: 22px;
    }

    .post-entry {
        border-radius: 18px;
    }

    .post-single {
        border-radius: 20px;
    }

    pre {
        padding: 13px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
    }

    .post-entry:hover {
        transform: none;
    }
}

/* 面包屑：浅蓝色透明液态玻璃 */
.breadcrumbs {
    box-sizing: border-box;
    margin-bottom: 18px;
    border: 1px solid rgba(255, 255, 255, 0.42) !important;
    border-radius: 16px;
    background: linear-gradient(
        120deg,
        rgba(255, 255, 255, 0.16),
        rgba(205, 225, 250, 0.12)
    ) !important;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.40),
        0 6px 20px rgba(79, 112, 158, 0.04);
    -webkit-backdrop-filter: blur(22px) saturate(155%);
    backdrop-filter: blur(22px) saturate(155%);
}

/* 博文主体：与两侧留出间距 */
.post-single {
    box-sizing: border-box;
    margin-inline: 8px;
}

/* 手机端保留少量侧边空隙 */
@media (max-width: 768px) {
    .breadcrumbs {
        margin-bottom: 14px;
    }

    .post-single {
        margin-inline: 4px;
    }
}

/* Markdown 正文：增加类似 PDF 的内侧装订边距 */
.post-single .post-content {
    box-sizing: border-box !important;
    width: 100%;
    max-width: 100%;
    padding-top: 30px !important;
    padding-right: clamp(28px, 5vw, 60px) !important;
    padding-bottom: 44px !important;
    padding-left: clamp(36px, 6vw, 72px) !important;
    margin: 0 !important;
}

/* 正文首尾不额外叠加默认外边距 */
.post-single .post-content > :first-child {
    margin-top: 0;
}

.post-single .post-content > :last-child {
    margin-bottom: 0;
}

/* 手机端：避免可用阅读宽度过窄 */
@media (max-width: 768px) {
    .post-single .post-content {
        padding: 22px 18px 30px !important;
    }
}


/* 博文详情页：标题与元信息居中 */
.post-single .post-header {
    text-align: center !important;
}

.post-single .post-header .post-title {
    width: 100%;
    text-align: center !important;
    margin-inline: auto;
}

.post-single .post-header .post-meta {
    justify-content: center;
    text-align: center !important;
}

/* 修复 PaperMod 博文主标题未居中 */
h1.post-title.entry-hint-parent {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
    transform: none !important;
}
