
import fs from "node:fs/promises";
import path from "node:path";

const sourceDir = path.resolve("content");
const outputDir = path.resolve("content-luogu");

async function walk(dir) {
    const files = [];

    for (const entry of await fs.readdir(dir, {
        withFileTypes: true
    })) {
        const full = path.join(dir, entry.name);

        if (entry.isDirectory()) {
            files.push(...await walk(full));
        } else if (entry.isFile() && entry.name.endsWith(".md")) {
            files.push(full);
        }
    }

    return files;
}

function convertMarkdown(source) {
    const lines = source.split(/\r?\n/);
    const output = [];
    const stack = [];

    let fenceChar = null;
    let fenceLength = 0;
    let converted = 0;

    function rawArgument(value) {
        // 用 Hugo 原始字符串，避免 LaTeX 的反斜杠被转义。
        if (value.includes("`")) {
            return JSON.stringify(value);
        }

        return `\`${value}\``;
    }

    for (const line of lines) {
        // 代码块内的冒号语法必须原样保留。
        if (fenceChar !== null) {
            output.push(line);

            const close = line.match(/^ {0,3}(`{3,}|~{3,})\s*$/);

            if (
                close &&
                close[1][0] === fenceChar &&
                close[1].length >= fenceLength
            ) {
                fenceChar = null;
                fenceLength = 0;
            }

            continue;
        }

        // 兼容洛谷的 ```cpp line-numbers 语法。
        const fence = line.match(/^(\s{0,3})(`{3,}|~{3,})(.*)$/);

        if (fence) {
            const marker = fence[2];
            let result = line;

            const info = fence[3].trim();
            const numbered = info.match(/^([^\s]+)\s+line-numbers$/);

            if (numbered) {
                result =
                    fence[1] +
                    marker +
                    numbered[1] +
                    " {linenos=true}";
            }

            output.push(result);
            fenceChar = marker[0];
            fenceLength = marker.length;
            continue;
        }

        // 允许指令行末尾存在用于换行的反斜杠。
        const candidate = line.replace(/\\\s*$/, "");

        // 识别 :::info[标题]{open} 等洛谷容器。
        const opening = candidate.match(
            /^\s*(:{3,})(info|success|warning|error|epigraph)\[([\s\S]*?)\](?:\{([^}]*)\})?\s*$/
        );

        if (opening) {
            const markerCount = opening[1].length;
            const type = opening[2];
            const title = opening[3];
            const attributes = opening[4] || "";

            if (type === "epigraph") {
                output.push(
                    `{{% epigraph author=${rawArgument(title)} %}}`
                );

                stack.push({
                    markerCount,
                    shortcode: "epigraph"
                });
            } else {
                const params = [
                    `type="${type}"`,
                    `title=${rawArgument(title)}`
                ];

                if (/\bopen\b/.test(attributes)) {
                    params.push('open="true"');
                }

                output.push(
                    `{{% callout ${params.join(" ")} %}}`
                );

                stack.push({
                    markerCount,
                    shortcode: "callout"
                });
            }

            converted++;
            continue;
        }

        // 关闭标记必须匹配当前最内层容器。
        const closing = candidate.match(/^\s*(:{3,})\s*$/);

        if (closing && stack.length) {
            const markerCount = closing[1].length;
            const current = stack[stack.length - 1];

            if (markerCount === current.markerCount) {
                stack.pop();
                output.push(`{{% /${current.shortcode} %}}`);
                converted++;
                continue;
            }
        }

        output.push(line);
    }

    return {
        text: output.join("\n"),
        converted
    };
}

async function main() {
    try {
        await fs.access(sourceDir);
    } catch {
        throw new Error(
            `找不到 ${sourceDir}。请先进入博客项目根目录。`
        );
    }

    await fs.rm(outputDir, {
        recursive: true,
        force: true
    });

    // 复制文章、图片以及页面资源，保留原始 content 不变。
    await fs.cp(sourceDir, outputDir, {
        recursive: true
    });

    const files = await walk(outputDir);
    let total = 0;

    for (const file of files) {
        const original = await fs.readFile(file, "utf8");
        const result = convertMarkdown(original);

        if (result.converted > 0) {
            await fs.writeFile(file, result.text, "utf8");
            total += result.converted;

            console.log(
                `${path.relative(outputDir, file)}: ` +
                `转换 ${result.converted} 个容器标记`
            );
        }
    }

    console.log(`完成：检查 ${files.length} 个 Markdown 文件。`);
    console.log(`转换了 ${total} 个洛谷容器标记。`);
    console.log(`Hugo 构建目录：${outputDir}`);
}

main().catch(error => {
    console.error(error);
    process.exitCode = 1;
});
