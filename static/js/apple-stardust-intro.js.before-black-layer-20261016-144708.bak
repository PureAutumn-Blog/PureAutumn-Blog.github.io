(() => {
  'use strict';

  // A failed effect must never leave a screen-covering layer behind.
  const ROOT_ID = 'apple-stardust-intro';
  const STYLE_ID = 'apple-stardust-intro-style';
  if (document.getElementById(ROOT_ID)) return;
  if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;

  const words = ['Hello.', 'Welcome.', 'Hello, world.', 'Nice to see you.'];
  const word = words[Math.floor(Math.random() * words.length)];
  let root = null;
  let style = null;
  let canvas = null;
  let ctx = null;
  let mask = null;
  let mctx = null;
  let raf = 0;
  let autoClose = 0;
  let dismissed = false;
  let lastFrame = 0;
  let startAt = 0;
  let width = 0;
  let height = 0;
  let scale = 1;
  let particles = [];
  let ambience = [];
  const mouse = { x: -10000, y: -10000 };

  const random = (min, max) => min + Math.random() * (max - min);
  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

  function cleanUp() {
    dismissed = true;
    if (raf) cancelAnimationFrame(raf);
    if (autoClose) clearTimeout(autoClose);
    window.removeEventListener('pointerdown', onPointerDown, true);
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('keydown', onKeyDown, true);
    window.removeEventListener('resize', onResize);
    if (root) root.remove();
    if (style) style.remove();
    root = style = canvas = ctx = mask = mctx = null;
  }

  function leave() {
    if (dismissed) return;
    dismissed = true;
    if (raf) cancelAnimationFrame(raf);
    if (autoClose) clearTimeout(autoClose);
    window.removeEventListener('pointerdown', onPointerDown, true);
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('keydown', onKeyDown, true);
    window.removeEventListener('resize', onResize);
    if (root) {
      root.classList.add('as-leaving');
      root.style.pointerEvents = 'none';
      window.setTimeout(() => {
        root?.remove();
        style?.remove();
      }, 620);
    } else {
      style?.remove();
    }
  }

  function onPointerDown(event) {
    if (event.target instanceof Element && event.target.closest('#' + ROOT_ID + ' .as-skip')) return;
    // Do not prevent/default-stop the underlying click: links still work on first click.
    leave();
  }
  function onPointerMove(event) {
    mouse.x = event.clientX;
    mouse.y = event.clientY;
  }
  function onKeyDown(event) {
    if (event.key === 'Escape') leave();
  }
  function onResize() {
    try {
      resizeAndBuild();
      startAt = performance.now();
      lastFrame = 0;
      // Test one render before keeping the overlay alive.
      drawFrame(startAt);
    } catch (error) {
      console.error('[stardust] resize failed; disabling intro safely.', error);
      cleanUp();
    }
  }

  function makeStyle() {
    style = document.createElement('style');
    style.id = STYLE_ID;
    style.textContent = `
      #${ROOT_ID}{position:fixed;inset:0;z-index:2147483000;overflow:hidden;isolation:isolate;opacity:1;visibility:visible;pointer-events:none;background:transparent;-webkit-font-smoothing:antialiased;transition:opacity .62s ease,visibility .62s}
      #${ROOT_ID}.as-leaving{opacity:0;visibility:hidden}
      #${ROOT_ID} canvas{position:absolute;inset:0;display:block;width:100%;height:100%;pointer-events:none}
      #${ROOT_ID} .as-caption{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;pointer-events:none;transform:translateY(-2.2vh)}
      #${ROOT_ID} .as-subtitle{margin:100px 0 0;color:rgba(225,235,250,.58);font:500 10px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:.31em;text-transform:uppercase;opacity:0;animation:as-sub-in .7s 1.7s ease-out forwards}
      #${ROOT_ID} .as-hint{position:absolute;left:16px;right:16px;bottom:max(32px,env(safe-area-inset-bottom));margin:0;text-align:center;color:rgba(230,239,255,.62);font:400 12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:.04em;opacity:0;animation:as-hint-in .6s 1.4s ease-out forwards;pointer-events:none}
      #${ROOT_ID} .as-skip{position:absolute;z-index:2;top:max(18px,env(safe-area-inset-top));right:max(18px,env(safe-area-inset-right));padding:9px 14px;border:1px solid rgba(255,255,255,.20);border-radius:999px;color:rgba(255,255,255,.88);background:rgba(255,255,255,.09);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);font:500 12px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;cursor:pointer;pointer-events:auto}
      #${ROOT_ID} .as-skip:hover{background:rgba(255,255,255,.16)}
      @keyframes as-sub-in{to{opacity:1}}@keyframes as-hint-in{to{opacity:1}}
      @media(max-width:520px){#${ROOT_ID} .as-subtitle{margin-top:74px;font-size:9px;letter-spacing:.22em}#${ROOT_ID} .as-hint{bottom:max(26px,env(safe-area-inset-bottom))}}
    `;
  }

  function buildWordParticles() {
    const fontStack = '-apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif';
    const measure = document.createElement('canvas').getContext('2d');
    if (!measure) throw new Error('Canvas text measurement unavailable');

    let fontSize = Math.min(126, width * 0.12, height * 0.17);
    fontSize = Math.max(28, fontSize);
    measure.font = `600 ${fontSize}px ${fontStack}`;
    while (measure.measureText(word).width > width * 0.86 && fontSize > 24) {
      fontSize *= 0.9;
      measure.font = `600 ${fontSize}px ${fontStack}`;
    }

    const textWidth = measure.measureText(word).width;
    const maskWidth = Math.max(1, Math.ceil(Math.min(width * 0.88, textWidth + fontSize * 0.2)));
    const maskHeight = Math.max(1, Math.ceil(fontSize * 1.55));
    mask.width = maskWidth;
    mask.height = maskHeight;
    mctx.clearRect(0, 0, maskWidth, maskHeight);
    mctx.font = `600 ${fontSize}px ${fontStack}`;
    mctx.textAlign = 'center';
    mctx.textBaseline = 'middle';
    mctx.fillStyle = '#fff';
    mctx.fillText(word, maskWidth / 2, maskHeight / 2);

    const pixels = mctx.getImageData(0, 0, maskWidth, maskHeight).data;
    const step = fontSize < 56 ? 3 : 4;
    const targets = [];
    for (let y = 0; y < maskHeight; y += step) {
      for (let x = 0; x < maskWidth; x += step) {
        const alpha = pixels[(y * maskWidth + x) * 4 + 3];
        if (alpha > 90) targets.push({
          x: (width - maskWidth) / 2 + x,
          y: height * 0.455 - maskHeight / 2 + y,
          brightness: alpha / 255
        });
      }
    }
    if (targets.length < 40) throw new Error('Not enough star positions to draw a readable word');

    const maxParticles = Number(navigator.hardwareConcurrency || 8) <= 4 ? 360 : 580;
    let picked = targets;
    if (targets.length > maxParticles) {
      picked = [];
      const stride = targets.length / maxParticles;
      for (let i = 0; i < maxParticles; i++) picked.push(targets[Math.floor(i * stride)]);
    }

    particles = picked.map((p, i) => ({
      sx: random(0, width), sy: random(0, height),
      tx: p.x + random(-0.35, 0.35), ty: p.y + random(-0.35, 0.35),
      size: random(0.65, 1.55), alpha: random(0.62, 1) * (0.6 + 0.4 * p.brightness),
      delay: random(0, 350), phase: random(0, Math.PI * 2), i
    }));
  }

  function resizeAndBuild() {
    width = Math.max(1, window.innerWidth);
    height = Math.max(1, window.innerHeight);
    scale = Math.min(window.devicePixelRatio || 1, 1.25, Math.sqrt(3200000 / (width * height)));
    canvas.width = Math.max(1, Math.floor(width * scale));
    canvas.height = Math.max(1, Math.floor(height * scale));
    ctx.setTransform(scale, 0, 0, scale, 0, 0);
    buildWordParticles();
    const count = Math.max(24, Math.min(58, Math.floor(width * height / 19000)));
    ambience = Array.from({ length: count }, () => ({
      x: random(0, width), y: random(0, height), r: random(0.35, 1.1),
      alpha: random(0.14, 0.48), phase: random(0, Math.PI * 2), speed: random(0.08, 0.28)
    }));
  }

  function drawFrame(now) {
    // If the canvas starts failing, safeTick() removes the layer completely.
    ctx.clearRect(0, 0, width, height);
    const bg = ctx.createRadialGradient(width * 0.5, height * 0.44, 1, width * 0.5, height * 0.44, Math.max(width, height) * 0.72);
    bg.addColorStop(0, '#101724');
    bg.addColorStop(0.45, '#070b12');
    bg.addColorStop(1, '#020308');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, width, height);

    ctx.globalCompositeOperation = 'lighter';
    for (const s of ambience) {
      const pulse = 0.56 + 0.44 * Math.sin(now * 0.001 + s.phase);
      s.y -= s.speed * 0.12;
      if (s.y < -2) { s.y = height + 2; s.x = random(0, width); }
      ctx.beginPath();
      ctx.fillStyle = `rgba(168,202,255,${s.alpha * pulse})`;
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }

    const elapsed = now - startAt;
    for (const p of particles) {
      const raw = clamp((elapsed - p.delay - 240) / 1900, 0, 1);
      const ease = 1 - Math.pow(1 - raw, 3.15);
      const wander = raw < 1 ? (1 - ease) * 10 : 0.45;
      let x = p.sx + (p.tx + Math.sin(now * 0.0013 + p.phase) * wander - p.sx) * ease;
      let y = p.sy + (p.ty + Math.cos(now * 0.0011 + p.phase) * wander - p.sy) * ease;

      // Gentle mouse repulsion after most particles have reached the letters.
      if (raw > 0.7) {
        const dx = x - mouse.x, dy = y - mouse.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > 0 && d2 < 82 * 82) {
          const d = Math.sqrt(d2);
          const force = (82 - d) / 82 * 2.0;
          x += dx / d * force;
          y += dy / d * force;
        }
      }
      const pulse = 0.7 + 0.3 * Math.sin(now * 0.003 + p.phase);
      const alpha = p.alpha * pulse * (raw < 0.1 ? 0.6 : 1);
      ctx.beginPath();
      ctx.fillStyle = `rgba(230,240,255,${alpha})`;
      ctx.arc(x, y, p.size, 0, Math.PI * 2);
      ctx.fill();
      if (p.i % 23 === 0 && raw > 0.75) {
        ctx.strokeStyle = `rgba(216,232,255,${alpha * 0.48})`;
        ctx.lineWidth = 0.55;
        ctx.beginPath();
        ctx.moveTo(x - 2, y); ctx.lineTo(x + 2, y);
        ctx.moveTo(x, y - 2); ctx.lineTo(x, y + 2);
        ctx.stroke();
      }
    }
    ctx.globalCompositeOperation = 'source-over';
  }

  function safeTick(now) {
    if (dismissed || !root?.isConnected) return;
    if (now - lastFrame < 1000 / 30) {
      raf = requestAnimationFrame(safeTick);
      return;
    }
    lastFrame = now;
    try {
      drawFrame(now);
      raf = requestAnimationFrame(safeTick);
    } catch (error) {
      console.error('[stardust] drawing failed; removing intro so the blog stays usable.', error);
      cleanUp();
    }
  }

  function boot() {
    try {
      // Prepare everything off-screen. The dark intro is not appended until the first
      // complete render succeeds, avoiding a black-only overlay on initialization errors.
      canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      ctx = canvas.getContext('2d', { alpha: false });
      mask = document.createElement('canvas');
      mctx = mask.getContext('2d', { willReadFrequently: true });
      if (!ctx || !mctx) throw new Error('Canvas 2D is unavailable');

      resizeAndBuild();
      startAt = performance.now();
      drawFrame(startAt); // Must succeed before the overlay becomes visible.

      makeStyle();
      root = document.createElement('div');
      root.id = ROOT_ID;
      root.setAttribute('aria-label', 'Stars gather to form a greeting');
      root.innerHTML = '<div class="as-caption"><p class="as-subtitle">WELCOME TO MY WORLD</p></div><p class="as-hint">星辰汇聚成字 · 点击进入 · Press Esc to skip</p><button class="as-skip" type="button" aria-label="跳过开场">跳过 ↗</button>';
      root.appendChild(canvas);

      document.head.appendChild(style);
      document.body.appendChild(root);
      root.querySelector('.as-skip').addEventListener('click', leave);
      window.addEventListener('pointerdown', onPointerDown, true);
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('keydown', onKeyDown, true);
      window.addEventListener('resize', onResize, { passive: true });
      console.info(`[stardust] ${particles.length} stars will form “${word}”.`);
      raf = requestAnimationFrame(safeTick);
      autoClose = window.setTimeout(leave, 7200);
    } catch (error) {
      console.error('[stardust] initialization failed; the blog is left visible.', error);
      cleanUp();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
})();
